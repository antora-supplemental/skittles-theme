{
  "name": "skittles-theme",
  "version": "0.1.0",
  "description": "Skittles: a high-vibrance, high-contrast Antora theme. Skittles Layout (a small overlay on Valentus Layout) plus Skittles Paint (11 color schemes on the --cs-* contract of @antora-supplemental/color-scheme).",
  "private": true,
  "keywords": [
    "antora",
    "antora-theme",
    "documentation",
    "asciidoc",
    "color-scheme"
  ],
  "homepage": "https://antora-supplemental.org/skittles-theme/",
  "license": "MIT",
  "author": "Ryan Johnson (https://github.com/AMDphreak)",
  "engines": {
    "antora": "^3.1.0"
  },
  "antoraRegistry": {
    "worksWith": {"valentus-theme":"^4.2.1","@antora-supplemental/color-scheme":"^0.5.3","@antora-supplemental/light-dark-mode":"^0.1.3","@antora-supplemental/brand-placeholder":"^0.1.0"},
    "provides": {"skittles-paint-tokens":"0.1"},
    "uses": {"valentus-layout-markup":"4","color-scheme-tokens":"^0.5","light-dark-slots":"^0.1"},
    "layers": ["paint", "body-kit"],
    "antora": "3",
    "colorSchemes": "paint/css/skittles-paint.css",
    "previews": [
      { "url": "preview.png", "caption": "Strawberry (light)" },
      { "url": "registry/previews/dark.png", "caption": "Grape (dark)" },
      { "url": "registry/previews/orangedark.png", "caption": "Orange (dark)" },
      { "url": "registry/previews/grapesoda.png", "caption": "Grape Soda (special)" }
    ]
  },
  "files": [
    "paint/**/*",
    "packages/skittles-layout/**/*"
  ],
  "scripts": {
    "build": "antora antora-playbook.yml",
    "build:local": "antora antora-playbook-local.yml",
    "build:bundle": "node scripts/build-bundle.mjs",
    "paint:schemes": "node scripts/build-schemes.mjs",
    "paint:validate": "node scripts/validate-all-paint.mjs",
    "paint:bake": "node scripts/bake-paint.mjs",
    "test": "node --test test/*.test.js paint/test/*.test.js",
    "test:layout": "node test/layout/content-top.mjs",
    "test:a11y": "contrast-check build/site --config contrast-check.config.json",
    "screenshots": "node scripts/screenshots.mjs",
    "serve": "pnpm build:local && npx http-server build/site -p 8080 -o",
    "clean": "rimraf build .cache"
  },
  "devDependencies": {
    "@antora-supplemental/contrast-check": "github:antora-supplemental/antora-ui-chassis#contrast-check-v0.1.0&path:packages/contrast-check",
    "@antora-supplemental/brand-placeholder": "github:antora-supplemental/antora-ui-chassis#brand-placeholder-v0.1.0&path:packages/brand-placeholder",
    "@antora-supplemental/color-scheme": "github:antora-supplemental/antora-ui-chassis#color-scheme-v0.5.3&path:packages/color-scheme",
    "@antora-supplemental/light-dark-mode": "github:antora-supplemental/antora-ui-chassis#light-dark-mode-v0.1.3&path:packages/light-dark-mode",
    "@antora-supplemental/valentus-layout": "github:antora-supplemental/valentus-theme#v4.2.1&path:packages/valentus-layout",
    "@antora/lunr-extension": "1.0.0-alpha.12",
    "@asciidoctor/tabs": "^1.0.0-beta.6",
    "antora": "^3.1.14",
    "axe-core": "^4.14.0",
    "http-server": "^14.1.1",
    "json5": "^2.2.3",
    "playwright-core": "^1.64.1",
    "rimraf": "^6.0.1"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "paint/lib/index.js"
}
